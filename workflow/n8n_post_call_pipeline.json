    {
      "id": "d8602771-3372-58f1-a4cb-47c762ae2632",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "jsCode": "\n// Join call log + CRM lead + demo evaluation + order + catalog into one LLM context\nconst call = $('Webhook: Call Recording Ready').item.json.body;\nconst lead = $('CRM: Get Lead').all().map(i=>i.json).find(r => String(r.id) === String(call.lead_id));\nconst demo = $('Sheets: Demo Evaluations').all().map(i=>i.json).find(r => String(r.lead_id) === String(call.lead_id)) || {};\nconst order = $('Sheets: Orders').all().map(i=>i.json).find(r => String(r.lead_id) === String(call.lead_id)) || null;\nconst cat = $('Sheets: Catalog').all().map(i=>i.json).find(r => String(r.class_id) === String(lead.class_id)) || null;\nconst feeCol = {INR:'standard_fee_india_inr', AED:'standard_fee_gcc_aed', USD:'standard_fee_usa_usd'};\nconst transcript = $('Transcribe (multilingual, diarized)').item.json.results.channels[0].alternatives[0].paragraphs.transcript;\nreturn [{ json: { call, lead, demo, order, catalog: cat, transcript,\n  catalogFee: order && cat && feeCol[order.currency] ? Number(cat[feeCol[order.currency]]) : null,\n  discountCap: cat ? Number((cat.max_rep_discount_allowed_pct.match(/(\\d+)%/)||[0,10])[1])/100 : 0.10 } }];\n"
      }
    },
    {
      "id": "a8bad665-6114-5bea-938f-c23edf9d82f9",
      "name": "LLM: Audit & Extract (Prompt 01)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.LLM_API_URL}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.LLM_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL, temperature: 0, response_format: {type: 'json_object'}, messages: [ {role: 'system', content: $('Load Prompts').item.json['01']}, {role: 'user', content: `<CALL_LOG>${JSON.stringify($json.call)}</CALL_LOG><CRM_LEAD>${JSON.stringify($json.lead)}</CRM_LEAD><DEMO_EVALUATION>${JSON.stringify($json.demo)}</DEMO_EVALUATION><CATALOG_POLICY>${JSON.stringify($json.catalog)}</CATALOG_POLICY><TRANSCRIPT>${$json.transcript}</TRANSCRIPT>`} ] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "797b8ec2-e586-596c-8be3-e7e60da9e0cb",
      "name": "Rules Engine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "jsCode": "\n// Port of scripts/rules_engine.py core logic (verification, scoring, caps, intent, stage, gates)\nconst ctx = $('Build Context').item.json;\nconst out = JSON.parse($json.choices ? $json.choices[0].message.content : $json.content[0].text);\nconst norm = s => (s||'').normalize('NFKC').replace(/[\u2018\u2019]/g,\"'\").replace(/[\u201c\u201d]/g,'\"').replace(/\\s+/g,' ').trim().toLowerCase();\nconst T = norm(ctx.transcript);\nconst verified = q => T.includes(norm(q));\nconst W = {D1:10,D2:20,D3:20,D4:20,D5:15,D6:10,D7:5};\nlet total = 0, review = [];\nfor (const d of out.audit.dimensions) {\n  let s = d.score;\n  if (s > 0 && !(d.evidence||[]).some(e => verified(e.quote))) { s = 0; review.push(d.id + ' unverified'); }\n  if (out.audit.rubric_gaming_detected && ['D1','D2'].includes(d.id)) s = 0;\n  total += s/4*W[d.id];\n}\nconst flags = out.compliance_flags.filter(f => verified(f.quote));\nconst crit = flags.some(f => f.severity==='CRITICAL'), high = flags.some(f => f.severity==='HIGH');\nconst finalScore = Math.min(total, crit ? 30 : high ? 60 : 100);\n// intent\nconst S = {parent_stated_pain:1,fee_accepted:1,price_objection_unresolved:-1,schedule_confirmed:1,next_step_agreed_with_time:1,explicit_commitment_to_pay:2,decision_maker_absent:-1,competitor_active:-1,info_requested:1,conditional_yes_with_available_fix:2,explicit_buying_question:2,parent_visible_enthusiasm:1};\nconst E = {5:2,4:1,3:0,2:-1,1:-1};\nlet pts = 2 + (E[ctx.demo.child_engagement_score_1_to_5]||0);\nfor (const [k,w] of Object.entries(S)) { const v = out.crm.intent_signals[k]; if (v && v.value && (!v.quote || verified(v.quote))) pts += w; }\nconst os = ctx.order ? ctx.order.payment_link_status : null;\nif (['Unpaid_Link_Opened_Twice','Payment_Failed'].includes(os)) pts += 2;\nlet intent = Math.max(1, Math.min(9, pts));\nif (os === 'Paid') intent = 10;\nif (out.crm.intent_signals.dnc_or_hostile && out.crm.intent_signals.dnc_or_hostile.value) intent = 1;\nconst label = os==='Paid' ? 'Converted' : intent>=8 ? 'Hot' : intent>=4 ? 'Warm' : 'Cold';\nconst stage = crit ? 'Compliance_Hold' : os==='Paid' ? 'Enrolled_Paid' : os==='Payment_Failed' ? 'Payment_Failed_Recovery' : 'Follow_Up_' + label;\n// discount guardrail from order vs catalog\nlet discountBreach = false;\nif (ctx.order && ctx.catalogFee) discountBreach = Number(ctx.order.discount_applied)/ctx.catalogFee > ctx.discountCap;\nreturn [{ json: { ...out, final_score: Math.round(finalScore*10)/10, grade: crit ? 'AUTO-FAIL' : finalScore>=85?'A':finalScore>=70?'B':finalScore>=50?'C':'D',\n  critical: crit || discountBreach, high, intent_score: intent, intent_label: label, crm_stage: stage,\n  needs_human_review: out.needs_human_review || review.length>0 || crit, review, lead: ctx.lead, order: ctx.order } }];\n"
      }
    },
    {
