        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL, temperature: 0.4, response_format: {type: 'json_object'}, messages: [ {role: 'system', content: $('Load Prompts').item.json['02']}, {role: 'user', content: `<CRM_CLEAN>${JSON.stringify($json)}</CRM_CLEAN><ORDER>${JSON.stringify($json.order)}</ORDER><GATE_RESULT>${$json.crm_stage}</GATE_RESULT><TZ>${$json.lead.city_timezone}</TZ>`} ] }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "ffa86d08-300b-5636-8186-c96a50bf8ccd",
      "name": "Send Gate (tiers, paid, quiet hours, regex)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        450
      ],
      "parameters": {
        "jsCode": "\n// Final approval tier = stricter of LLM proposal and tag/flag rules; paid gate; quiet hours; regex safety\nconst RANK = {T0_AUTO:0,T1_COUNSELLOR:1,T2_TEAM_LEAD:2,T3_MANAGER:3};\nconst TAG = {recap:0,payment_retry:0,onboarding:0,price:1,installment:1,discount:1,batch_change:1,seat_hold:1,objection_answer:1,new_concession:2,apology:3};\nconst banned = /guarantee|guaranteed|100% result|rank 1|topper|last chance|only today|expires in|hurry|blacklist|kindly confirm payment|dear parent|refund anytime/i;\nconst audit = $('Rules Engine').item.json;\nconst seq = JSON.parse($json.choices ? $json.choices[0].message.content : $json.content[0].text);\nconst items = [];\nfor (const t of seq.touches) {\n  let lvl = RANK[t.proposed_approval];\n  for (const tag of t.content_tags) lvl = Math.max(lvl, TAG[tag] ?? 1);\n  if (audit.crm_stage === 'Compliance_Hold') lvl = 3;\n  if (t.touch === 1 && audit.high) lvl = Math.max(lvl, 2);\n  let status = 'READY';\n  if (audit.order && audit.order.payment_link_status === 'Paid' && seq.mode === 'SALES_SEQUENCE') status = 'BLOCKED';\n  if (banned.test(t.message)) status = 'FIX_REQUIRED';\n  items.push({ json: { lead_id: seq.lead_id, ...t, final_approval: Object.keys(RANK)[lvl], gate_status: status, sequence_mode: seq.mode } });\n}\nreturn items;\n"
      }
    },
    {
      "id": "483a8508-efb5-5c7d-92f5-9d5424ef2d82",
      "name": "LLM: Safety Check (Prompt 03)",
