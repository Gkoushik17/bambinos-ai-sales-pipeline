    {
      "id": "d18ead25-19cb-562e-b07b-ca39d820f9fb",
      "name": "LLM: Follow-up Writer (Prompt 02)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        450
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.LLM_API_URL}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
