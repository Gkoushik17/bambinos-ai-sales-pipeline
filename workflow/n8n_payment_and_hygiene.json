    {
      "id": "c7969a7b-e29a-59b9-88c0-d896fc4fa3d2",
      "name": "Sheets: Leads + Demos",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        600
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.CRM_SHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "1_crm_leads"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
