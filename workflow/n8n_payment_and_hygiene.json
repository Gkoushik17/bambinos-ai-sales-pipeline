          "name": "Bambinos Sheets"
        }
      }
    },
    {
      "id": "dd8fcfc1-d5b4-5d04-822b-4535552d7727",
      "name": "Hygiene Rules (SLA, duplicates, stale follow-ups)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        600
      ],
      "parameters": {
        "jsCode": "const now = new Date();\nconst rows = $input.all().map(i => i.json);\nconst alerts = []; const seen = {};\nfor (const r of rows.sort((a,b) => a.created_at.localeCompare(b.created_at))) {\n  for (const k of ['student_id','mobile']) { const key = k+':'+r[k]; if (seen[key] && seen[key] !== r.lead_code) alerts.push({lead: r.lead_code, code: 'DUPLICATE_LEAD', of: seen[key]}); seen[key] = seen[key] || r.lead_code; }\n  if (r.crm_lead_stage === 'Demo_Completed_Uncalled' && r.demo_completed_at && (now - new Date(r.demo_completed_at))/36e5 > 2) alerts.push({lead: r.lead_code, code: 'UNCALLED_SLA_BREACH', owner: r.assigned_counsellor_name});\n  if (r.last_call_at && r.last_call_at !== 'NULL' && (r.next_followup_at === 'NULL' || r.next_followup_at < r.last_call_at)) alerts.push({lead: r.lead_code, code: 'FOLLOWUP_DATE_INVALID'});\n}\nreturn alerts.map(a => ({json: a}));"
      }
    },
    {
      "id": "de6ff07b-3621-5797-bcdd-83fc1af600a2",
      "name": "Slack: P1 Alerts to Rep + Team Lead",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        680,
        600
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#sales-p1-alerts"
        },
        "text": "=\u23f1\ufe0f {{$json.code}}: {{$json.lead}} {{$json.owner ? '(' + $json.owner + ')' : ''}} {{$json.of ? 'duplicate of ' + $json.of : ''}}"
      },
      "credentials": {
        "slackApi": {
          "id": "2",
          "name": "Bambinos Slack"
        }
      }
    }
  ],
