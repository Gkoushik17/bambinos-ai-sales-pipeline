{
  "name": "Bambinos | Payment Events + CRM Hygiene Sweep",
  "nodes": [
    {
      "id": "0fca1c54-9a0a-51c4-94c9-915b10a1fda6",
      "name": "Webhook: Razorpay / Stripe Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "payment-event",
        "options": {}
      }
    },
    {
      "id": "b7a925a7-34c2-5b63-9cd6-ede12c5f67fe",
      "name": "Normalise Payment Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "const b = $json.body;\nconst status = b.event === 'payment.captured' || b.type === 'checkout.session.completed' ? 'Paid' : (b.event === 'payment.failed' || b.type === 'payment_intent.payment_failed') ? 'Payment_Failed' : 'Other';\nreturn [{json: {lead_id: b.payload?.notes?.lead_id || b.data?.object?.metadata?.lead_id, status, reason: b.payload?.payment?.entity?.error_reason || b.data?.object?.last_payment_error?.code || null, amount: b.payload?.payment?.entity?.amount || b.data?.object?.amount}}];"
      }
    },
    {
      "id": "f569a1b0-e8e1-59d6-88c5-ae6e33594c7c",
      "name": "Switch: Paid / Failed",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        440,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.status}}",
                    "rightValue": "Paid",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "paid"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.status}}",
                    "rightValue": "Payment_Failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "failed"
            }
          ]
        }
      }
    },
    {
      "id": "44e3b0b4-026f-5127-b46e-dbc9d681fd77",
      "name": "CRM: Enrolled_Paid + Cancel Sales Cadence",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        80
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.CRM_SHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "ai_cleaned_crm"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "lead_id"
          ],
          "value": {
            "lead_id": "={{$json.lead_id}}",
            "ai_crm_stage": "Enrolled_Paid",
            "sales_cadence_active": "FALSE"
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "1",
          "name": "Bambinos Sheets"
        }
      }
    },
    {
